<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup><ProjectReference Include="../Pollotikito.Infrastructure/Pollotikito.Infrastructure.csproj" />
  <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12"><PrivateAssets>all</PrivateAssets></PackageReference></ItemGroup>
  <Target Name="BuildFrontend" BeforeTargets="ComputeFilesToPublish" Condition="'$(SkipFrontendBuild)' != 'true'">
    <Exec WorkingDirectory="../../Frontend" Command="npm ci" />
    <Exec WorkingDirectory="../../Frontend" Command="npm run build" />
    <ItemGroup><ResolvedFileToPublish Include="../../Frontend/dist/**/*"><RelativePath>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</RelativePath><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory></ResolvedFileToPublish></ItemGroup>
  </Target>
</Project>
