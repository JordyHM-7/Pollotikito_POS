<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>740759eb-f88f-4ce8-af6d-7496559c04d9</UserSecretsId>
  </PropertyGroup>

  <ItemGroup><ProjectReference Include="../Pollotikito.Infrastructure/Pollotikito.Infrastructure.csproj" />
  <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12"><PrivateAssets>all</PrivateAssets></PackageReference></ItemGroup>
  <Target Name="BuildFrontend" AfterTargets="ComputeFilesToPublish" Condition="'$(SkipFrontendBuild)' != 'true'">
    <Exec WorkingDirectory="../../Frontend" Command="npm ci --no-audit --no-fund" Condition="'$(SkipFrontendInstall)' != 'true'" />
    <Exec WorkingDirectory="../../Frontend" Command="npm run build" />
    <ItemGroup>
      <FrontendDist Include="../../Frontend/dist/**/*" />
      <ResolvedFileToPublish Include="@(FrontendDist-&gt;'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
